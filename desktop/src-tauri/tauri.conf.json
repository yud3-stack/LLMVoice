{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLMVoice Studio",
  "version": "1.0.0",
  "identifier": "com.llmvoice.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LLMVoice Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/**"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNEMwQ0QzMUZGODA3QjgKUldTNEIvZ2Ywd3hNbkpTQ1hLcGNRNmVCVDNzRkhzMkUzSkc1Q3BPU2dCZkpMdlpkb0k2d3pWUFIK",
      "endpoints": ["https://github.com/yud3-stack/LLMVoice/releases/download/desktop-latest/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.svg"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
